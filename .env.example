# ==== Server ====
# Backend listens only on localhost in the local install.
PORT=4000
HOST=127.0.0.1
NODE_ENV=production

# ==== Database ====
# PostgreSQL connection string (Prisma driver adapter).
# The installer generates a real .env with random credentials.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/clinic_panel?schema=public&sslmode=disable"

# ==== Redis (BullMQ job queue) — always local ====
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# ==== JWT ====
# Generate random secrets, e.g.:
#   openssl rand -hex 64
# In production the insecure default values below are rejected by config validation.
JWT_ACCESS_SECRET="change_me_to_a_long_random_secret_at_least_16_chars"
JWT_REFRESH_SECRET="change_me_to_a_different_long_random_secret_at_least_16_chars"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ==== CORS ====
# Comma-separated list of allowed browser origins (no trailing slash).
CORS_ORIGINS="http://127.0.0.1:3000,http://localhost:3000"

# ==== SMS ====
# Kept for future use only — SMS is not an install dependency today.
SMS_PROVIDER=mock
SMS_API_KEY=mock

# ==== Storage (local filesystem only for the local install) ====
STORAGE_DRIVER=local
# Absolute path outside the source tree. The installer points this at
# C:\ProgramData\HakimClinic\uploads
UPLOAD_DIR=C:\ProgramData\HakimClinic\uploads

# ==== PDF rendering (Puppeteer) ====
# Optional: explicit path to Chrome/Edge. When empty, the system browser is
# resolved from common install paths (Edge is present on Windows 10/11).
# PUPPETEER_EXECUTABLE_PATH=C:\Program Files (x86)\Microsoft\Edge\Application\msedge.exe
