# ==== Server ====
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# ==== Database ====
# PostgreSQL connection string (Prisma driver adapter)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/clinic_panel?schema=public&sslmode=disable"

# ==== Redis (BullMQ job queue) ====
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ==== JWT ====
# Use strong random secrets, especially in production:
#   openssl rand -hex 64
# In production the default values below are rejected by config validation.
JWT_ACCESS_SECRET="change_me_to_a_long_random_secret_at_least_16_chars"
JWT_REFRESH_SECRET="change_me_to_a_different_long_random_secret_at_least_16_chars"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ==== CORS ====
# Comma-separated list of allowed browser origins (no trailing slash).
CORS_ORIGINS="http://localhost:3000"

# ==== SMS ====
SMS_PROVIDER=kavenegar
SMS_API_KEY=mock_api_key

# ==== Storage (local filesystem or S3-compatible) ====
STORAGE_DRIVER=local
UPLOAD_DIR=uploads
S3_ENDPOINT=https://s3.ir-thr-at1.arvanstorage.ir
S3_REGION=default
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=clinic-panel-storage
